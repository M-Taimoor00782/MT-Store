{% render 'custom-section-frame', section: section %}
{% style %}
  #shopify-section-{{ section.id }} {
    display: flow-root;
    --trust-overlap: {{ section.settings.overlap }}px;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} { --trust-overlap: {{ section.settings.overlap_mobile }}px; }
  }
{% endstyle %}
<div class="{{ section.settings.setwidth }}">
  <ul class="custom-trust-badges" role="list" style="--trust-surface: {{ section.settings.background }};">
    {% for block in section.blocks %}
      <li {{ block.shopify_attributes }}>
        <div class="trust-emblem" aria-hidden="true">
          {% if block.settings.icon != blank %}
            {{ block.settings.icon | image_url: width: 72 | image_tag: widths: '36, 72', sizes: '32px', loading: 'lazy', alt: '' }}
          {% else %}
            {% case block.settings.symbol %}
              {% when 'delivery' %}{% render 'icon-truck' %}
              {% when 'payment' %}{% render 'icon-lock' %}
              {% when 'support' %}{% render 'icon-comment' %}
              {% when 'quality' %}{% render 'icon-tick' %}
              {% when 'return' %}{% render 'icon-exchange' %}
              {% else %}
                <svg class="trust-shield" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m16 3 11 4v8c0 7-6 12-11 14C11 27 5 22 5 15V7l11-4Z"/><path d="m11 15 4 4 7-8"/>
                </svg>
            {% endcase %}
          {% endif %}
        </div>
        {% if block.settings.badge_tag != blank %}<small>{{ block.settings.badge_tag | escape }}</small>{% endif %}
        {% if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}
        {% if block.settings.subtext != blank %}<p>{{ block.settings.subtext | escape }}</p>{% endif %}
      </li>
    {% endfor %}
  </ul>
</div>
{% stylesheet %}
  .custom-trust-badges {
    --trust-rule: color-mix(in srgb, currentColor 16%, transparent);
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    position: relative; z-index: 1;
    list-style: none; margin: calc(-1 * var(--trust-overlap)) 0 0; padding: 0; overflow: hidden;
    border: 1px solid var(--trust-rule); border-radius: .75rem;
    background: linear-gradient(115deg, var(--trust-surface), color-mix(in srgb, var(--trust-surface) 97%, currentColor));
    box-shadow: 0 .35rem 1.5rem color-mix(in srgb, currentColor 5%, transparent);
  }
  .custom-trust-badges:empty { display: none; }
  .custom-trust-badges li {
    min-width: 0; padding: clamp(1.25rem, 3vw, 3rem); overflow-wrap: anywhere;
    box-shadow: 1px 0 var(--trust-rule), 0 1px var(--trust-rule);
  }
  .custom-trust-badges .trust-emblem {
    display: inline-grid; place-items: center; width: 3.25rem; height: 3.25rem;
    margin-bottom: 1rem; border: 1px solid var(--trust-rule); border-radius: 50%;
    transition: transform .3s ease, background-color .3s ease;
  }
  .custom-trust-badges svg { fill: none; }
  .custom-trust-badges .icon-truck .a { stroke: currentColor; }
  .custom-trust-badges .icon-lock { font-size: 1.65rem; line-height: 1; }
  .custom-trust-badges .trust-emblem :is(svg, img) { width: 1.85rem; height: 1.85rem; object-fit: contain; }
  .custom-trust-badges small { display: block; margin-bottom: .5rem; font-size: .7rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  .custom-trust-badges h3 { margin: 0; font-size: clamp(1.15rem, 1.75vw, 1.55rem); line-height: 1.2; letter-spacing: -.02em; }
  .custom-trust-badges p { margin: .5rem 0 0; line-height: 1.5; opacity: .8; }
  @media (hover: hover) {
    .custom-trust-badges li:hover .trust-emblem { transform: translateY(-3px); background-color: var(--trust-surface); }
  }
  @media (max-width: 768px) {
    .custom-trust-badges { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .custom-trust-badges li { padding: 1.25rem 1rem; }
    .custom-trust-badges li:last-child:nth-child(odd) { grid-column: 1 / -1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .custom-trust-badges .trust-emblem { transition: none; }
    .custom-trust-badges li:hover .trust-emblem { transform: none; }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "custom - Trust Badges",
  "settings": [
    {
      "type": "select",
      "id": "setwidth",
      "label": "Section width",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "container-fluid",
          "label": "Fluid container"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "container"
    },
    { "type": "color", "id": "background", "label": "Background color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#18222d" },
    { "type": "text", "id": "paddingsection", "label": "Desktop padding", "default": "0 0 32px" },
    { "type": "text", "id": "paddingmobile", "label": "Mobile padding", "default": "0 0 20px" },
    { "type": "range", "id": "overlap", "label": "Desktop overlap above", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "overlap_mobile", "label": "Mobile overlap above", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 14 },
    { "type": "text_alignment", "id": "text_alignment", "label": "Text alignment", "default": "left" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust badge",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Custom icon" },
        {
          "type": "select",
          "id": "symbol",
          "label": "Built-in icon",
          "default": "shield",
          "options": [
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "delivery",
              "label": "Shipping truck"
            },
            { "value": "payment", "label": "Secure payment" },
            { "value": "support", "label": "Customer support" },
            { "value": "quality", "label": "Quality checked" },
            {
              "value": "return",
              "label": "Return"
            }
          ]
        },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "text", "id": "subtext", "label": "Subtext" },
        { "type": "text", "id": "badge_tag", "label": "Badge tag" }
      ]
    }
  ],
  "presets": [
    {
      "name": "custom - Trust Badges",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "heading": "Shipping Truck",
            "symbol": "delivery"
          }
        },
        {
          "type": "badge",
          "settings": {
            "heading": "Secure Payment",
            "symbol": "payment"
          }
        },
        {
          "type": "badge",
          "settings": {
            "heading": "Customer Support",
            "symbol": "support"
          }
        },
        { "type": "badge", "settings": { "heading": "Quality Checked", "symbol": "quality" } }
      ]
    }
  ]
}
{% endschema %}
