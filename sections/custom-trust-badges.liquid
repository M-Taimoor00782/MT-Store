{% render 'custom-section-frame', section: section %}
<div class="{{ section.settings.setwidth }}">
  <ul class="custom-trust-list" role="list">
    {% for block in section.blocks %}
      <li {{ block.shopify_attributes }}>
        <div class="custom-trust-symbol">
          {% if block.settings.icon != blank %}
            {{ block.settings.icon | image_url: width: 96 | image_tag: widths: '48, 96', sizes: '42px', loading: 'lazy', alt: '' }}
          {% else %}
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {% case block.settings.symbol %}
                {% when 'delivery' %}<path d="M2 8h17v15h-3m-9 0H2V8Zm17 5h6l5 6v4h-3m-7 0h-5"/><circle cx="10" cy="23" r="3"/><circle cx="24" cy="23" r="3"/>
                {% when 'return' %}<path d="m11 5-6 6 6 6M6 11h13a8 8 0 0 1 0 16h-6"/>
                {% else %}<path d="m16 3 11 4v8c0 7-6 12-11 14C11 27 5 22 5 15V7l11-4Z"/><path d="m11 15 4 4 7-8"/>
              {% endcase %}
            </svg>
          {% endif %}
        </div>
        {% if block.settings.badge_tag != blank %}<small class="text-uppercase">{{ block.settings.badge_tag | escape }}</small>{% endif %}
        {% if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}
        {% if block.settings.subtext != blank %}<p>{{ block.settings.subtext | escape }}</p>{% endif %}
      </li>
    {% endfor %}
  </ul>
</div>
{% stylesheet %}
  .custom-trust-list { display: flex; flex-wrap: wrap; list-style: none; margin: 0; padding: 0; }
  .custom-trust-list li { flex: 1 1 11rem; min-width: 0; padding: 1rem clamp(.75rem, 2vw, 2rem); border-inline-start: 1px solid currentColor; border-color: color-mix(in srgb, currentColor 17%, transparent); transition: transform .3s ease; }
  .custom-trust-list li:first-child { border-inline-start: 0; }
  .custom-trust-list li:hover { transform: translateY(-3px); }
  .custom-trust-symbol svg, .custom-trust-symbol img { width: 42px; height: 42px; object-fit: contain; margin-bottom: .75rem; }
  .custom-trust-list h3 { margin: .3rem 0; font-size: 1.15rem; }
  .custom-trust-list p { margin: 0; }
  @media (max-width: 768px) {
    .custom-trust-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .custom-trust-list li:nth-child(odd) { border-inline-start: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .custom-trust-list li { transition: none; } }
{% endstylesheet %}
{% schema %}
{
  "name": "custom - Trust Badges",
  "settings": [
    {
      "type": "select",
      "id": "setwidth",
      "label": "Section width",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "container-fluid",
          "label": "Fluid container"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "container"
    },
    { "type": "color", "id": "background", "label": "Background color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#18222d" },
    { "type": "text", "id": "paddingsection", "label": "Desktop padding", "default": "64px 0" },
    { "type": "text", "id": "paddingmobile", "label": "Mobile padding", "default": "36px 0" },
    { "type": "text_alignment", "id": "text_alignment", "label": "Text alignment", "default": "left" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust badge",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Custom icon" },
        {
          "type": "select",
          "id": "symbol",
          "label": "Built-in icon",
          "default": "shield",
          "options": [
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "delivery",
              "label": "Delivery"
            },
            {
              "value": "return",
              "label": "Return"
            }
          ]
        },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "text", "id": "subtext", "label": "Subtext" },
        { "type": "text", "id": "badge_tag", "label": "Badge tag" }
      ]
    }
  ],
  "presets": [
    {
      "name": "custom - Trust Badges",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "heading": "Delivery",
            "symbol": "delivery"
          }
        },
        {
          "type": "badge",
          "settings": {
            "heading": "Returns",
            "symbol": "return"
          }
        },
        {
          "type": "badge",
          "settings": {
            "heading": "Secure checkout",
            "symbol": "shield"
          }
        }
      ]
    }
  ]
}
{% endschema %}
