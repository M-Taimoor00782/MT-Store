{% render 'custom-section-frame', section: section %}
<div class="{{ section.settings.setwidth }}">
  {% render 'custom-section-heading', section: section %}
  <div class="custom-bento-grid">
    {% for block in section.blocks %}
      {% assign sizes = '(max-width: 768px) 50vw, 25vw' %}
      {% if forloop.first %}{% assign sizes = '(max-width: 768px) 100vw, 50vw' %}{% endif %}
      {% render 'custom-collection-tile', block: block, section: section, layout: 'bento', sizes: sizes, index: forloop.index %}
    {% endfor %}
  </div>
</div>
{% stylesheet %}
  .custom-bento-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(.5rem, 1.4vw, 1.5rem); }
  .custom-bento-grid .custom-collection-tile:first-child { grid-area: span 2 / span 2; }
  .custom-bento-grid .custom-collection-tile { min-height: 8rem; width: 100%; height: 100%; }
  .custom-bento-grid .custom-tile-label { inset-inline: .65rem; bottom: .65rem; padding: .7rem 2.25rem .7rem .9rem; border-radius: 1.25rem; background: rgba(255,255,255,.86); color: #172126; backdrop-filter: blur(12px); }
  .custom-bento-grid .custom-tile-label h3 { font-size: clamp(.95rem, 1.5vw, 1.6rem); }
  .custom-bento-grid .custom-tile-label svg { position: absolute; width: 18px; height: 18px; right: .8rem; top: calc(50% - 9px); transition: transform .32s ease; }
  .custom-bento-grid .custom-collection-tile:is(:hover,:focus-within) svg:not(.custom-tile-photo) { transform: translate(3px,-3px); }
  @media (max-width: 768px) {
    .custom-bento-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .custom-bento-grid .custom-collection-tile:first-child { grid-row: span 1; }
  }
  @media (prefers-reduced-motion: reduce) { .custom-bento-grid .custom-tile-label svg { transition: none; } }
{% endstylesheet %}
{% schema %}
{
  "name": "custom - Bento Grid",
  "settings": [
    {
      "type": "select",
      "id": "setwidth",
      "label": "Section width",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "container-fluid",
          "label": "Fluid container"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "container"
    },
    { "type": "color", "id": "background", "label": "Background color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#18222d" },
    { "type": "text", "id": "paddingsection", "label": "Desktop padding", "default": "64px 0" },
    { "type": "text", "id": "paddingmobile", "label": "Mobile padding", "default": "36px 0" },
    { "type": "text_alignment", "id": "text_alignment", "label": "Text alignment", "default": "left" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured collections" },
    { "type": "richtext", "id": "description", "label": "Description" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "default": "square",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        },
        {
          "value": "natural",
          "label": "Natural"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "custom - Collection Bento Grid",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
