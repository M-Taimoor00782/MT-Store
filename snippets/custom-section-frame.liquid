{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.background }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.paddingsection | escape }};
    text-align: {{ section.settings.text_alignment }};
  }
  #shopify-section-{{ section.id }} :is(h2, h3, p) { color: inherit; }
  #shopify-section-{{ section.id }} .custom-section-heading { margin-bottom: clamp(1.25rem, 3vw, 3rem); }
  #shopify-section-{{ section.id }} .custom-section-heading > :last-child { margin-bottom: 0; }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} { padding: {{ section.settings.paddingmobile | escape }}; }
  }
{% endstyle %}
