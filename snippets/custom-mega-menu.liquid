<div class="ch-mega-content">
  <div class="ch-mega-column">
    <a href="{{ link.url | escape }}"><strong>{{ link.title | escape }}</strong></a>
    {% for child in link.links %}
      <a href="{{ child.url | escape }}">{{ child.title | escape }}</a>
      {% for leaf in child.links %}<a class="pl-2" href="{{ leaf.url | escape }}">{{ leaf.title | escape }}</a>{% endfor %}
    {% endfor %}
  </div>
  {% for index in (1..3) %}
    {% assign key = 'column_' | append: index %}
    {% assign column = block.settings[key] %}
    {% if column != blank %}
      <div class="ch-mega-column">
        <strong>{{ column.title | escape }}</strong>
        {% for item in column.links %}
          <a href="{{ item.url | escape }}">{{ item.title | escape }}</a>
          {% for child in item.links %}<a class="pl-2" href="{{ child.url | escape }}">{{ child.title | escape }}</a>{% endfor %}
        {% endfor %}
      </div>
    {% endif %}
  {% endfor %}
  {% for index in (1..2) %}
    {% liquid
      assign image_key = 'image_' | append: index
      assign heading_key = 'heading_' | append: index
      assign url_key = 'url_' | append: index
      assign image = block.settings[image_key]
      assign heading = block.settings[heading_key]
      assign url = block.settings[url_key]
    %}
    {% if image != blank or heading != blank %}
      <div class="ch-promo">
        {% if url != blank %}<a href="{{ url | escape }}">{% endif %}
        {% if image != blank %}
          {{ image | image_url: width: 720 | image_tag: widths: '240, 360, 540, 720', sizes: '(max-width: 768px) 75vw, 16vw', loading: 'lazy' }}
        {% endif %}
        {% if heading != blank %}<strong>{{ heading | escape }}</strong>{% endif %}
        {% if url != blank %}</a>{% endif %}
      </div>
    {% endif %}
  {% endfor %}
</div>
