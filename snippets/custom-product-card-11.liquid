{% liquid
  assign sizes = 'auto, (max-width: 768px) 50vw, 25vw'
  assign variant = product.selected_or_first_available_variant
  assign primary = variant.featured_image | default: product.featured_image
  assign secondary = product.images[1]
  if secondary.id == primary.id
    assign secondary = product.images.first
  endif
  assign sale = false
  if settings.sale_label_enable and variant.compare_at_price > variant.price
    assign sale = true
  endif
  assign today = 'now' | date: '%s'
  assign published = product.published_at | date: '%s'
  assign age = today | minus: published | divided_by: 86400
  assign new_days = settings.new_label_day | plus: 0
  assign is_new = false
  if settings.new_label_enable and age <= new_days
    assign is_new = true
  endif
  assign add_label = 'products.product.add_to_cart' | t
  assign sold_label = 'products.product.sold_out' | t
%}
<custom-product-card-11 class="product-card cc11 js-product-card" data-add-label="{{ add_label | escape }}" data-sold-label="{{ sold_label | escape }}">
  <div class="cc11-media">
    <a class="cc11-images" href="{{ variant.url | default: product.url }}" data-product-link aria-label="{{ product.title | escape }}">
      <span class="cc11-primary">
        {% if primary %}
          {{ primary | image_url: width: 960 | image_tag: widths: '240, 400, 640, 960', sizes: sizes, loading: 'lazy', alt: '' }}
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </span>
      {% if secondary and secondary.id != primary.id %}
        {{ secondary | image_url: width: 960 | image_tag: widths: '240, 400, 640, 960', sizes: sizes, class: 'cc11-secondary', loading: 'lazy', alt: '' }}
      {% endif %}
    </a>
    <div class="cc11-badges">
      {% if settings.sale_label_enable %}<span data-sale {% unless sale %}hidden{% endunless %}>{{ settings.sale_label_text | default: 'Sale' | escape }}</span>{% endif %}
      {% if is_new %}<span data-new {% if sale %}hidden{% endif %}>{{ settings.new_label_text | default: 'New' | escape }}</span>{% endif %}
    </div>
    <div class="cc11-actions">
      <span><button type="button" class="btn btn-theme js-grid-cart px-2 py-1" data-id="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}
        aria-label="{% if variant.available %}{{ add_label | escape }}{% else %}{{ sold_label | escape }}{% endif %}">
        {% render 'icon-cart' %}
      </button></span>
      {% if settings.enable_wishlsit %}
        <span><button type="button" class="btn btn-theme js-btn-wishlist px-2 py-1" data-handle="{{ product.handle }}" aria-label="{{ 'products.product.wishlist_text' | t | escape }}">{% render 'icon-heart' %}</button></span>
      {% endif %}
      {% if settings.qv_box %}
        <span><button type="button" class="btn btn-theme js-btn-quickview px-2 py-1" data-handle="{{ product.handle }}" data-pavailable="{{ product.available }}" data-toggle="modal" data-target="#jsQuickview" aria-label="{{ 'products.product.quickview_text' | t | escape }}">
          {% render 'icon-view' %}
          <span class="txt-short hide">{{ product.metafields.info.shortdesc | default: product.description | strip_html | truncatewords: 12 | escape }}</span>
        </button></span>
      {% endif %}
    </div>
  </div>
  <h3 class="cc11-title"><a href="{{ variant.url | default: product.url }}" data-product-link>{{ product.title | escape }}</a></h3>
  <div aria-live="polite"><span data-price>{{ variant.price | money }}</span>
    <s data-compare {% unless variant.compare_at_price > variant.price %}hidden{% endunless %}>{{ variant.compare_at_price | money }}</s>
  </div>
  {% if settings.e_swatch %}
    {% for option in product.options_with_values %}
      {% liquid
        assign key = option.name | downcase
        assign native_swatches = option.values | map: 'swatch' | compact
      %}
      {% if key == 'color' or key == 'colour' or native_swatches.size > 0 %}
        <div class="cc11-swatches" role="group" aria-label="{{ option.name | escape }}">
          {% for value in option.values %}
            {% liquid
              assign name = value.name | default: value
              assign option_key = option.position | prepend: 'option'
              assign choices = product.variants | where: option_key, name
              assign available = choices | where: 'available', true | first
              assign choice = available | default: choices.first | default: value.variant
              if variant[option_key] == name
                assign choice = variant
              endif
              assign photo = choice.featured_image | default: product.featured_image
              assign dot_image = value.swatch.image
              if value.swatch.color == blank and dot_image == blank
                assign dot_image = choice.featured_image
              endif
            %}
            {% if choice %}
              <button type="button" class="btn p-1" aria-label="{{ name | escape }}" aria-pressed="{% if choice.id == variant.id %}true{% else %}false{% endif %}"
                data-choice="{{ choice.id }}" data-url="{{ choice.url | escape }}" data-available="{{ choice.available }}"
                data-price="{{ choice.price | money | strip_html | escape }}" data-compare="{% if choice.compare_at_price > choice.price %}{{ choice.compare_at_price | money | strip_html | escape }}{% endif %}">
                <span class="cc11-dot st-color-{{ name | handleize }}" style="--dot-color: {% if value.swatch.color %}{{ value.swatch.color }}{% else %}{{ name | handleize }}{% endif %};{% if dot_image %} background-image: url('{{ dot_image | image_url: width: 48 | escape }}');{% endif %}"></span>
                {% if photo %}<template>{{ photo | image_url: width: 960 | image_tag: widths: '240, 400, 640, 960', sizes: sizes, alt: '' }}</template>{% endif %}
              </button>
            {% endif %}
          {% endfor %}
        </div>
        {% break %}
      {% endif %}
    {% endfor %}
  {% endif %}
</custom-product-card-11>

{% stylesheet %}
  .cc11 { display: block; min-width: 0; }
  .cc11 svg { fill: none; }
  .cc11-media { position: relative; isolation: isolate; }
  .cc11-images { display: block; position: relative; overflow: hidden; aspect-ratio: 4 / 5; background: #f3f2ef; }
  .cc11-images :is(img,svg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .cc11-secondary { opacity: 0; transition: opacity .5s ease, transform .7s ease; }
  .cc11-badges { position: absolute; top: .75rem; left: .75rem; pointer-events: none; }
  .cc11-badges span { display: inline-block; background: #fff; color: #202326; border-radius: 2rem; padding: .25em .8em; font-size: .8em; animation: cc11-badge-in .45s ease both; }
  .cc11 [hidden] { display: none; }
  @keyframes cc11-badge-in { from { opacity: 0; transform: translateY(-5px); } }
  .cc11-actions { position: absolute; bottom: .6rem; inset-inline: .4rem; display: flex; flex-wrap: wrap; align-items: end; justify-content: center; gap: .3rem; }
  .cc11-actions svg { width: 20px; height: 20px; }
  .cc11-actions > span { transition: opacity .22s ease, transform .3s ease; }
  .cc11-actions > span:nth-child(2) { transition-delay: 45ms; }
  .cc11-actions > span:nth-child(3) { transition-delay: 90ms; }
  .cc11-title { margin: .85rem 0 .3rem; font-size: 1.1rem; }
  .cc11-title a { color: inherit; }
  .cc11-swatches { display: inline-flex; flex-wrap: wrap; margin-top: .35rem; }
  .cc11-dot { display: block; width: 1rem; height: 1rem; border: 1px solid #898989; border-radius: 50%; background-size: cover; background-position: center; background-color: var(--dot-color); }
  .cc11 [aria-pressed="true"] .cc11-dot { outline: 1px solid currentColor; outline-offset: 2px; }
  @media (hover: hover) and (pointer: fine) {
    .cc11-media:is(:hover,:focus-within) .cc11-secondary { opacity: 1; transform: scale(1.05); }
    .cc11:not(:hover,:focus-within) .cc11-actions > span { opacity: 0; transform: translateY(.65rem); pointer-events: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cc11-secondary, .cc11-actions > span { transition: none; }
    .cc11-badges span { animation: none; }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('custom-product-card-11')) {
    customElements.define('custom-product-card-11', class extends HTMLElement {
      constructor() {
        super();
        this.addEventListener('click', event => {
          const swatch = event.target.closest('[data-choice]');
          if (swatch && swatch.getAttribute('aria-pressed') !== 'true') this.selectSwatch(swatch);
        });
      }
      async selectSwatch(swatch) {
        const choice = swatch.dataset;
        this.querySelectorAll('[data-choice]').forEach(item => item.setAttribute('aria-pressed', String(item === swatch)));
        this.querySelectorAll('[data-product-link]').forEach(link => { link.href = choice.url; });
        const add = this.querySelector('.js-grid-cart');
        add.dataset.id = choice.choice;
        // The theme's delegated cart handler reads jQuery's data cache.
        window.jQuery?.(add).data('id', choice.choice);
        add.disabled = choice.available !== 'true';
        add.setAttribute('aria-label', add.disabled ? this.dataset.soldLabel : this.dataset.addLabel);
        this.querySelector('[data-price]').textContent = choice.price;
        const compare = this.querySelector('s');
        compare.hidden = !choice.compare;
        compare.textContent = choice.compare;
        const sale = this.querySelector('[data-sale]');
        if (sale) sale.hidden = !choice.compare;
        const fresh = this.querySelector('[data-new]');
        if (fresh) fresh.hidden = Boolean(sale && choice.compare);

        const source = swatch.querySelector('template')?.content.firstElementChild;
        if (!source) return;
        const image = document.importNode(source, true);
        const primary = this.querySelector('.cc11-primary');
        try { await image.decode(); } catch { return; }
        if (swatch.getAttribute('aria-pressed') !== 'true') return;
        const previous = primary.lastElementChild;
        primary.append(image);
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          await image.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 300 }).finished;
        }
        previous?.remove();
      }
    });
  }
{% endjavascript %}
